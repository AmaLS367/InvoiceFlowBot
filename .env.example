# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Local OCR (default)
OCR_PROVIDER=local
OCR_LANGUAGES=eng+rus

# Mindee credentials are only used with OCR_PROVIDER=mindee.
# MINDEE_API_KEY=
# MINDEE_MODEL_ID=

# Logging Configuration (optional)
# LOG_LEVEL=INFO
# LOG_ROTATE_MB=10
# LOG_BACKUPS=5
# LOG_CONSOLE=0
# LOG_DIR=

# Database Configuration (optional)
# Path is resolved from the backend directory; ../data.sqlite maps to the project root.
# INVOICE_DB_PATH=../data.sqlite
